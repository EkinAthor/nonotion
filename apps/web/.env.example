# Base URL of the API, baked into the bundle at build time (redeploy/rebuild after changing).
# Must end in /api — all backend routes are registered under /api/.
# Leave unset in local dev (the Vite dev server proxies /api to localhost:3001).
# VITE_API_URL=https://api.your-domain.com/api

# Build the app in demo mode (localStorage-backed, no backend).
# VITE_DEMO_MODE=true

# User-visible app title (browser tab, sidebar, login/register/consent pages).
# Visual re-branding only — baked into the bundle at build time (rebuild/redeploy after changing).
# VITE_APP_TITLE=Nonotion

# Open-source notices on the login page (landing line + GitHub footer link). On by default;
# set to false to hide. Baked into the bundle at build time.
# VITE_OPEN_SOURCE_NOTICE=true
