# ==============================================================================
# Nonotion API Environment Configuration
# Copy this file to .env for local development
# ==============================================================================

# JWT secret for signing tokens - change in production!
JWT_SECRET=dev-secret-change-in-production

# Admin email - user registering with this email becomes admin
# If not set, the first registered user becomes admin
ADMIN_EMAIL=

# Require admin approval for new users (default: true)
REQUIRE_USER_APPROVAL=true

# API server port (default: 3001)
PORT=3001

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage backend: 'sqlite' (default) or 'postgres'
STORAGE_TYPE=sqlite

# Data directory for SQLite database (default: ../../data)
DATA_DIR=

# PostgreSQL connection URL (required when STORAGE_TYPE=postgres)
# DATABASE_URL=postgresql://nonotion:nonotion@localhost:5432/nonotion

# Maximum file upload size in MB (default: 10)
MAX_FILE_SIZE_MB=10

# Data directory for SQLite database and JSON files
# Can be absolute or relative path (relative to apps/api)
# Default: ../../data (project root data folder)
DATA_DIR=../../data

# Authentication modes (comma-separated): db | google | db,google (default: db)
AUTH_MODES=db

# Google OAuth Client ID (required when AUTH_MODES includes 'google')
# Get from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=

# Email (Resend) — required for the email two-factor authentication feature.
# On Vercel, installing the Resend Marketplace integration auto-provisions
# RESEND_API_KEY. Otherwise create an API key at https://resend.com.
RESEND_API_KEY=
# Sender address for verification emails (must be a Resend-verified domain/sender)
EMAIL_FROM="Nonotion <no-reply@example.com>"

# Rate limiting (default: enabled, auto-disabled on Vercel)
# Set RATE_LIMIT_ENABLED=false to disable all rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MINUTES=1
RATE_LIMIT_IMPORT_MAX=3
RATE_LIMIT_IMPORT_WINDOW_MINUTES=1
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MINUTES=1

# ------------------------------------------------------------------------------
# Real-time Collaboration (optional, requires Supabase)
# ------------------------------------------------------------------------------

# Enable real-time presence and live editing (default: false)
REALTIME_ENABLED=false

# Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase publishable API key (format: sb_publishable_...).
# Safe for frontend. Replaces the legacy anon key.
# Create in Dashboard -> Settings -> API -> API Keys.
SUPABASE_PUBLISHABLE_KEY=

# Supabase secret API key (format: sb_secret_...).
# Backend-only, NEVER expose to frontend. Replaces the legacy service_role key.
SUPABASE_SECRET_KEY=

# ES256 JWT signing key as a JWK (JSON Web Key) string, used to sign Realtime
# auth tokens. Backend-only. Generate with:
#   node apps/api/scripts/generate-jwt-signing-key.mjs
# Wrap the single-line JSON in single quotes in .env (JSON uses double quotes).
# Example: SUPABASE_JWT_PRIVATE_KEY='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","alg":"ES256","use":"sig"}'
SUPABASE_JWT_PRIVATE_KEY=

# Key ID (kid) shown by Supabase after importing the standby signing key.
# Dashboard -> Settings -> Auth -> JWT Signing Keys. Included in JWT header for verification.
SUPABASE_JWT_KID=

# ------------------------------------------------------------------------------
# MCP Server (optional) — read-only Claude / Model Context Protocol access
# ------------------------------------------------------------------------------

# Enable the MCP server, its OAuth endpoints, and the settings API (default: false)
MCP_ENABLED=false

# Public base URL of this API (OAuth issuer + MCP resource base, no trailing slash).
# REQUIRED in production when MCP_ENABLED=true. Default: http://localhost:3001
MCP_PUBLIC_URL=

# Frontend base URL used for the OAuth consent redirect.
# Default: first entry of CORS_ORIGINS (falls back to http://localhost:5173)
FRONTEND_URL=

# Token lifetimes (defaults: 60 min access, 30 day refresh, 10 min auth code)
MCP_ACCESS_TOKEN_TTL_MINUTES=60
MCP_REFRESH_TOKEN_TTL_DAYS=30
MCP_AUTH_CODE_TTL_MINUTES=10

# Rate limit for POST /mcp (default: 60 requests per 1 minute)
RATE_LIMIT_MCP_MAX=60
RATE_LIMIT_MCP_WINDOW_MINUTES=1

# ------------------------------------------------------------------------------
# File Attachments (optional) — upload files to pages as downloadable links
# ------------------------------------------------------------------------------

# Enable file attachments (routes + file block UI). Default: false
FILE_ATTACHMENTS_ENABLED=false

# Where attachment bytes live: db (BLOB in the app database, default) or
# supabase (private Supabase Storage bucket, signed URLs, encrypted at rest).
# supabase requires SUPABASE_URL + SUPABASE_SECRET_KEY (shared with Realtime).
# Note: the db backend streams uploads through the API — on Vercel that caps
# uploads at ~4.5MB; use supabase there.
FILE_STORAGE_BACKEND=db

# Private Supabase Storage bucket name (create manually, public OFF). Default: nonotion-files
FILE_BUCKET=nonotion-files

# Accepted file extensions, comma-separated, no dots.
# html/svg/js are always rejected regardless of this list.
# Default: pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,txt,md,csv,tsv,log,
#          json,yaml,yml,xml,toml,ics,zip,7z,gz,tar,rar,
#          jpg,jpeg,png,gif,webp,heic,bmp,tiff,mp3,wav,m4a,ogg,mp4,mov,webm,epub
FILE_ALLOWED_EXTENSIONS=

# Max attachment size in MB (default: 25). Images keep MAX_FILE_SIZE_MB.
FILE_MAX_SIZE_MB=25

# TTL for signed download URLs / download tokens in seconds (default: 300)
FILE_SIGNED_URL_TTL_SECONDS=300
